# Server Configuration
PORT=3001
BODY_LIMIT=10mb
NODE_ENV=production
JWT_SECRET=your-super-secret-jwt-key

# Database (PostgreSQL)
PGUSER=postgres
PGHOST=db
PGDATABASE=cyberdock
PGPASSWORD=your-secure-password
PGPORT=5432

# Firebase configuration (Production)
# These are used in utils/firebase.js when NODE_ENV=production
FIREBASE_PROJECT_ID=cyberdock-9b169
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_DB_URL=https://cyberdock-9b169-default-rtdb.firebaseio.com

# Shopee Open Platform API v2 (https://open.shopee.com/)
#
# IMPORTANTE: a Shopee valida o DOMÍNIO do redirect contra o campo
# "Redirect URL Domain" do console do parceiro. Como o console da CyberDock
# declara https://cyberdock.com.br/, o retorno da autorização precisa cair no
# FRONTEND (rota /shopee/callback), que então conclui a conexão via API.
# Se um dia o console passar a declarar o domínio da API, basta apontar esta
# variável para https://api.cyberdock.com.br/api/shopee/callback.
SHOPEE_PARTNER_ID=your-shopee-partner-id
SHOPEE_PARTNER_KEY=your-shopee-partner-key
SHOPEE_REDIRECT_URI=https://cyberdock.com.br/shopee/callback
FRONTEND_URL=https://cyberdock.com.br

# TikTok Shop Open API (https://partner.tiktokshop.com/)
#
# Os três valores vêm do app no Partner Center. Sem eles, conectar loja responde
# 503 com a lista do que falta; o resto do sistema segue funcionando.
#
# A URL de retorno NÃO vai aqui: o TikTok usa a "Redirect URL" cadastrada no
# app. Cadastre https://cyberdock.com.br/tiktok/callback (o frontend conclui a
# conexão pela API). https://api.cyberdock.com.br/api/tiktok/callback também
# funciona, concluindo direto no backend.
#
# O app precisa dos escopos de pedidos (Order Information) e de envio
# (Fulfillment/Logistics). Escopo adicionado depois exige reautorizar a loja.
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SERVICE_ID=
#
# Ajustes opcionais (os valores abaixo são os padrões):
# TIKTOK_LOOKBACK_DAYS=120
# TIKTOK_OVERLAP_MINUTES=15
# TIKTOK_DEEP_SWEEP_HOURS=12
# TIKTOK_WINDOW_DAYS=15
# TIKTOK_SYNC_COOLDOWN_SECONDS=60
# TIKTOK_JOB_TIMEOUT_MS=900000
# TIKTOK_SAVE_CONCURRENCY=3
# TIKTOK_SSE_MAX_PER_USER=10
# TIKTOK_SSE_MAX_GLOBAL=500
# TIKTOK_HTTP_TIMEOUT_MS=30000
# TIKTOK_HTTP_RETRIES=4
# TIKTOK_COOKIE_DOMAIN=

# Cobrança externa — Asaas (https://docs.asaas.com/)
#
# TUDO OPCIONAL. Sem ASAAS_API_KEY a integração fica DESLIGADA: o adaptador
# recusa qualquer chamada com "not_configured" em vez de bater na API sem
# credencial. Nenhuma rota do sistema usa o Asaas ainda.
#
# A chave é gerada na área de integrações do Asaas, por usuário administrador,
# e vale para UM ambiente. Ela dá acesso a movimentar dinheiro: nunca commitar,
# nunca colocar valor real neste arquivo de exemplo.
#
# ASAAS_ENV aceita "sandbox" (padrão) ou "production". Qualquer outro valor,
# inclusive "prod", cai em sandbox de propósito — o erro caro é ir para produção
# por engano, não o contrário.
ASAAS_ENV=sandbox
ASAAS_API_KEY=
#
# Token compartilhado do webhook: nós definimos ao cadastrar o webhook no Asaas
# e ele devolve em todo evento. Entre 32 e 255 caracteres. Sem esta variável, a
# validação recusa TODOS os eventos — endpoint que dá baixa em pagamento não
# pode ficar aberto.
ASAAS_WEBHOOK_TOKEN=
#
# Só para apontar para um mock em teste. Em uso normal, deixe vazio: a URL sai
# de ASAAS_ENV.
ASAAS_BASE_URL=
